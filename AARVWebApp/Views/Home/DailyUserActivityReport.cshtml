@model IEnumerable<AARVWebApp.Models.DailyUserActivityVM>

@{
    ViewBag.Title = "Daily User Activity Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
    int totalPages = ViewBag.TotalPages ?? 1;

    int startRecord = ((page - 1) * pageSize) + 1;
    int endRecord = Math.Min(page * pageSize, totalRecords);
}

<style>
    .btn-filter {
        background-color: #9b59b6;
        color: white;
        font-weight: 500;
    }

        .btn-filter:hover {
            background-color: #5858ff;
        }

    .btn-clear {
        background-color: #dcd7ff;
        color: #4a4a4a;
        font-weight: 500;
    }

        .btn-clear:hover {
            background-color: #c6c0ff;
        }

    .summary-card {
        border-radius: 12px;
        background: #f8f9ff;
        padding: 15px;
        box-shadow: 0px 2px 6px rgba(0,0,0,0.05);
        text-align: center;
    }

    .summary-number {
        font-size: 22px;
        font-weight: bold;
        color: #9b59b6;
    }

    .summary-label {
        font-size: 12px;
        color: #6c757d;
    }

    /* Pagination like client list */
    .pagination .page-link {
        width: 32px;
        height: 32px;
        line-height: 30px;
        border-radius: 50% !important;
        text-align: center;
        padding: 0;
        margin: 0 4px;
        font-size: 13px;
        color: #6c757d;
        border: 1px solid #ddd;
        background-color: #fff;
        transition: all 0.3s ease;
    }

        .pagination .page-link:hover {
            background-color: #f3e6ff;
            color: #9b59b6;
            border-color: #9b59b6;
        }

    .pagination .active .page-link {
        background-color: #9b59b6;
        border-color: #9b59b6;
        color: #fff;
    }

    .pagination .page-item.disabled .page-link {
        opacity: .5;
    }
</style>

<div class="main-panel">
    <div class="content-wrapper">

        <div class="page-header">
            <h3 class="page-title">Daily User Activity Report</h3>
        </div>

        <!-- SUMMARY CARDS -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-number">@totalRecords</div>
                    <div class="summary-label">Total Login Entries</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-number">@Model.Select(x => x.Username).Distinct().Count()</div>
                    <div class="summary-label">Unique Users</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-number">@Model.GroupBy(x => x.Browser).Count()</div>
                    <div class="summary-label">Browsers Used</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-number">@Model.GroupBy(x => x.IP).Count()</div>
                    <div class="summary-label">Unique IP Addresses</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <h4 class="card-title mb-3">Login Records</h4>

                <!-- FILTER -->
                <form method="get" class="row mb-4">

                    <div class="col-md-3">
                        <label class="mb-2">From Date</label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="mb-2">To Date</label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-filter w-100">Filter</button>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <a href="@Url.Action("DailyUserActivityReport")" class="btn btn-clear w-100">Clear Filter</a>
                    </div>

                </form>

                <!-- RECORD COUNT -->
                <div class="text-muted mb-2">
                    Showing <b>@startRecord</b> to <b>@endRecord</b> of <b>@totalRecords</b> records
                </div>

                <!-- TABLE -->
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Login Time</th>
                                <th>IP Address</th>
                                <th>Browser</th>
                                <th>Total User Logins</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Skip((page - 1) * pageSize).Take(pageSize))
                            {
                                <tr>
                                    <td>@item.Username</td>
                                    <td>@item.LoginTime.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                    <td>@item.IP</td>
                                    <td>@item.Browser</td>
                                    <td>@item.TotalLogins</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINATION -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-end mt-3">
                        <ul class="pagination pagination-sm mb-0">

                            <li class="page-item @(page == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("DailyUserActivityReport", new { page = page - 1, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                                    «
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("DailyUserActivityReport", new { page = i, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(page == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("DailyUserActivityReport", new { page = page + 1, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                                    »
                                </a>
                            </li>

                        </ul>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
