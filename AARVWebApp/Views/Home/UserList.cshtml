@model IEnumerable<AARVWebApp.Models.UserMaster>

@{
    ViewBag.Title = "UserList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h3 class="page-title">User List</h3>
        </div>
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">User List</h4>
                        <div clsass="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr class="border-1">
                                        <th scope="col">ID</th>
                                        <th scope="col">Username</th>
                                        <th scope="col">First Name</th>
                                        <th scope="col">Last Name</th>
                                        <th scope="col">Email</th>
                                        <th scope="col">Mobile</th>
                                        <th scope="col">Role</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var user in Model)
                                        {
                                            <tr>
                                                <td>@user.User_ID</td>
                                                <td>@user.Username</td>
                                                <td>@user.FirstName</td>
                                                <td>@user.LastName</td>
                                                <td>@user.Email</td>
                                                <td>@user.Mobile</td>
                                                <td>@user.Role</td>
                                                <td class="action-icons">
                                                    <a href="@Url.Action("UserDetails", "Home", new { id = user.User_ID })" class="btn btn-outline-primary btn-sm">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("UserEdit", "Home", new { id = user.User_ID })" class="btn btn-outline-success btn-sm">
                                                        <i class="fa fa-pencil-square-o"></i>
                                                    </a>
                                                    <a href="@Url.Action("UserDelete", "Home", new { id = user.User_ID })" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">
                                                        <i class="fa fa-trash-o"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted">No users found</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
