@model AARVWebApp.Models.UserMaster

@{
    ViewBag.Title = "UserDelete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="content-wrapper">
    <h3 class="page-title text-danger">Delete User</h3>
    <hr />

    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this user?</strong>
    </div>

    <dl class="row">
        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Username)</dd>

        <dt class="col-sm-2">Role</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Role)</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.User_ID)

        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("UserList", "Home")" class="btn btn-secondary">Cancel</a>
    }
</div>

