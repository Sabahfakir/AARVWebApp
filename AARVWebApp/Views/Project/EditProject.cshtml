@model AARVWebApp.Models.ProjectDetail

@{
    ViewBag.Title = "Edit Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12 mx-auto">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4">Edit Project</h4>

                    @using (Html.BeginForm("EditProject", "Project", FormMethod.Post))
                    {
                        @Html.HiddenFor(m => m.ProjectID)

                        <div class="form-group">
                            <label>Project Name</label>
                            @Html.TextBoxFor(m => m.ProjectName, new { @class = "form-control" })
                        </div>

                        
                        <div class="form-group">
                            <label>Category</label>
                            @Html.DropDownListFor(
                                m => m.CategoryID,
                                new SelectList(ViewBag.CategoryList, "Category_ID", "CategoryName", Model.CategoryID),
                                "-- Select Category --",
                                new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label>Status</label>
                            @Html.DropDownListFor(
                                m => m.StatusID,
                                new SelectList(ViewBag.StatusList, "Status_ID", "Status", Model.StatusID),
                                "-- Select Status --",
                                new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label>Project Manager</label>
                            @Html.TextBoxFor(m => m.ProjectManager, new { @class = "form-control", placeholder = "Enter Project Manager Name" })
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                        </div>

                        <div class="form-group">
                            <label>Start Date</label>
                            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}",
                                new { @class = "form-control", type = "date" })
                        </div>

                        <div class="form-group">
                            <label>Due Date</label>
                            @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}",
                                new { @class = "form-control", type = "date" })
                        </div>

                        <button class="btn btn-primary mt-3">Update</button>
                        <a href="/Project/ProjectList" class="btn btn-light mt-3">Cancel</a>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
