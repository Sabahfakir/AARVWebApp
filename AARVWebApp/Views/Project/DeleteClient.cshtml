
@model AARVWebApp.Models.ClientMaster
@{
    ViewBag.Title = "DeleteClient";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="main-panel">
    <div class="content-wrapper">
        <div class="card">
            <div class="card-body text-center">
                <h4>Are you sure you want to delete this client?</h4>
                <p><strong>@Model.ClientName</strong> - @Model.ProjectName</p>

                @using (Html.BeginForm("DeleteClient", "Project", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ClientID)
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a href="@Url.Action("ClientList", "Project")" class="btn btn-secondary">Cancel</a>
                }
            </div>
        </div>
    </div>
</div>


