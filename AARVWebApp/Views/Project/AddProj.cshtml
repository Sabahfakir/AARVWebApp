@model AARVWebApp.Models.ProjectDetail

@{
    ViewBag.Title = "Add Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Project</title>
    <style>
        .upload-area {
            border: 2px dashed #007bff;
            border-radius: 10px;
            background: #f8f9fa;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: 0.3s ease;
        }

            .upload-area:hover {
                background: #eef6ff;
            }

            .upload-area.dragover {
                background: #e2edff;
                border-color: #0056b3;
            }

        .file-list {
            margin-top: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 10px;
            background: #fafafa;
            max-height: 200px;
            overflow-y: auto;
        }

        .file-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 6px;
            padding: 8px 12px;
            margin-bottom: 8px;
        }

            .file-item span {
                font-size: 14px;
                color: #333;
            }

            .file-item button {
                border: none;
                background: transparent;
                color: #dc3545;
                cursor: pointer;
            }

                .file-item button:hover {
                    color: #a71d2a;
                }
    </style>

</head>
<body>
    <div class="content-wrapper p-4">
        <div class="container rounded p-4 shadow-sm bg-white">
            <h3 class="form-title mb-4">Add New Project</h3>

            @using (Html.BeginForm("AddProj", "Project", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="mb-3">
                    <label class="form-label">Project Name</label>
                    @Html.TextBoxFor(m => m.ProjectName, new { @class = "form-control", placeholder = "Enter project name" })
                </div>
                <div class="row mb-3">

                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        @Html.DropDownListFor(m => m.CategoryID, (SelectList)ViewBag.CategoryList, "Select Category", new { @class = "form-select" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Client</label>
                        @Html.DropDownListFor(m => m.ClientID, (SelectList)ViewBag.ClientList, "Select Client", new { @class = "form-select" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        @Html.DropDownListFor(m => m.StatusID, (SelectList)ViewBag.StatusList, "Select Status", new { @class = "form-select" })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Project Manager</label>
                    @Html.TextBoxFor(m => m.ProjectManager, new { @class = "form-control", placeholder = "Enter manager name" })
                </div>


                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Due Date</label>
                        @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>



                <div class="mb-3">
                    <label class="form-label">Description</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                </div>

                <div class="mb-3">
                    <label>Upload Files</label>
                    <input type="file" name="projectFiles" multiple class="form-control" />
                </div>

                <div class="text-end mt-3">
                    <button type="reset" class="btn btn-danger">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            }
        </div>
    </div>
</body>
</html>



