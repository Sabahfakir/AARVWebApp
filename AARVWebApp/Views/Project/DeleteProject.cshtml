@model AARVWebApp.Models.ProjectDetail
@{
    ViewBag.Title = "DeleteProject";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="main-panel">
    <div class="content-wrapper">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h3 class="mb-3 text-danger">Delete Project</h3>
                <p>Are you sure you want to delete this project?</p>

                <table class="table table-bordered text-start mt-4">
                    <tr>
                        <th>Project Name</th>
                        <td>@Model.ProjectName</td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td>@Model.Project_Category.CategoryName</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>@Model.Project_Status.Status</td>
                    </tr>
                    <tr>
                        <th>Start Date</th>
                        <td>@Model.StartDate?.ToString("dd-MMM-yyyy")</td>
                    </tr>
                    <tr>
                        <th>Due Date</th>
                        <td>@Model.DueDate?.ToString("dd-MMM-yyyy")</td>
                    </tr>
                </table>

                @using (Html.BeginForm("DeleteProject", "Project", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProjectID)
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a href="@Url.Action("ProjectList", "Project")" class="btn btn-secondary">Cancel</a>
                }
            </div>
        </div>
    </div>
</div>


