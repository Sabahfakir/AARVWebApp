
@model IEnumerable<AARVWebApp.Models.EmployeeMaster>

@{
    ViewBag.Title = "Employee List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel">
    <div class="content-wrapper">
        <div>
            <h3 class="page-title">Employee List</h3>

            @using (Html.BeginForm("EmpList", "Employee", FormMethod.Get))
            {
                <div class="filters d-flex gap-2 mt-3">
                    <select name="department" class="form-select">
                        <option>Department</option>
                        <option value="IT" @(ViewBag.Department == "IT" ? "selected" : "")>IT</option>
                        <option value="Digital Marketing" @(ViewBag.Department == "Digital Marketing" ? "selected" : "")>Digital Marketing</option>
                        <option value="HR" @(ViewBag.Department == "HR" ? "selected" : "")>HR</option>
                        <option value="Finance" @(ViewBag.Department == "Finance" ? "selected" : "")>Finance</option>
                    </select>

                    <select name="status" class="form-select">
                        <option>Employee Status</option>
                        <option value="Active" @(ViewBag.Status == "active" ? "selected" : "")>Active</option>
                        <option value="Not Active" @(ViewBag.Status == "Non Active" ? "selected" : "")>Non Active</option>
                    </select>

                    <button type="submit" class="btn btn-primary">Search</button>
                    <a href="@Url.Action("EmpList", "Employee")" class="btn btn-danger">Clear</a>
                </div>
            }

            <div class="mt-3">
                <a href="@Url.Action("AddEmp","Employee")" class="btn btn-success btn-create">+ Create Employee</a>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Employee List</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Full Name</th>
                                        <th>Contact No</th>
                                        <th>Email</th>
                                        <th>Designation</th>
                                        <th>Department</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var emp in Model)
                                        {
                                            <tr>
                                                <td>@emp.Emp_Code</td>
                                                <td>@(emp.FirstName + " " + emp.LastName)</td>
                                                <td>@emp.PhoneNo</td>
                                                <td>@emp.PersonalEmail </td>
                                                <td>@emp.Designation</td>
                                                <td>@emp.Department</td>
                                                <td>@emp.WorkStatus</td>
                                                <td class="action-icons">
                                                    <a href="@Url.Action("EmpDetails", "Employee", new { id = emp.Emp_ID })" class="btn btn-outline-primary btn-sm">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("EmpEdit", "Employee", new { id = emp.Emp_ID })" class="btn btn-outline-success btn-sm">
                                                        <i class="fa fa-pencil-square-o"></i>
                                                    </a>
                                                    <a href="@Url.Action("EmpDelete", "Employee", new { id = emp.Emp_ID })" class="btn btn-outline-danger btn-sm">
                                                        <i class="fa fa-trash-o"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center">No records found</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



