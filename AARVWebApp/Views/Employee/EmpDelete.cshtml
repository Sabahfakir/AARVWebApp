
@{
    ViewBag.Title = "EmpDelete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model AARVWebApp.Models.EmployeeMaster
@{
    ViewBag.Title = "Delete Employee";
}
<div class="content-wrapper">
    <h2>Delete Employee</h2>

    <div class="alert alert-danger">
        <p>Are you sure you want to delete this employee?</p>
    </div>

    <dl class="dl-horizontal">
        <dt>Employee Name</dt>
        <dd>@Model.FirstName @Model.MiddleName @Model.LastName</dd>

        <dt>Email</dt>
        <dd>@Model.OfficeEmail</dd>

        <dt>Designation</dt>
        <dd>@Model.Designation</dd>
    </dl>

    @using (Html.BeginForm("EmpDeleteConfirmed", "Employee", new { id = Model.Emp_ID }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete</button>
        @Html.ActionLink("Cancel", "EmpList", null, new { @class = "btn btn-secondary" })
    }

</div>
